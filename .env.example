# Database
DATABASE_URL=postgres://user:password@localhost:5432/postbox

# Better Auth (Next.js URL)
BETTER_AUTH_URL=http://localhost:3000

# Better Auth secret (run `openssl rand -hex 32` to generate)
BETTER_AUTH_SECRET=change-me-to-a-random-64-character-hex-string

# Optional scheduled mailbox sync endpoint. Set this to a random secret and
# send it as Authorization: Bearer <value> when calling GET /api/sync.
SYNC_CRON_SECRET=change-me-to-a-random-secret

# Encryption key for storing email passwords (32 hex bytes = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Billing provider (offline | stripe | paddle)
BILLING_PROVIDER=offline

# Platform administrators (comma-separated emails)
# These users get access to /admin
ADMIN_EMAILS=hello@ahmedadil.me

# Google OAuth — for "Continue with Google" button
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID → Web application
# 3. Add redirect URI: http://localhost:3000/api/auth/google/callback
# 4. Enable Gmail API in "APIs & Services > Library"
# 5. Set up OAuth consent screen with scope: https://mail.google.com/
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Microsoft OAuth — for "Continue with Microsoft" button
# 1. Go to https://portal.azure.com → Azure AD → App registrations
# 2. Create new registration → Web → add redirect URI
# 3. API permissions → Add → Microsoft Graph → Delegated:
#    IMAP.AccessAsUser.All, SMTP.Send, offline_access, openid, profile
# 4. Certificates & secrets → New client secret
MICROSOFT_CLIENT_ID=xxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=xxxx~xxxx
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback
